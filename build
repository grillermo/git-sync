#!/bin/sh
# Builds git-sync into bin/git-sync-<os>-<arch> for every supported target (or
# just the os/arch pairs given as arguments) and points bin/git-sync at this
# machine's own build. `git-sync install` sends each peer the build matching
# its platform, so build every platform a peer runs on. See bin/.gitignore.
#   ./build                 all targets
#   ./build linux/amd64     just that one
set -eu
cd "$(dirname "$0")"
name=git-sync

# --- this machine's real OS and CPU: what bin/git-sync points at ----------
case "$(uname -s)" in
  Darwin) HOSTOS=darwin ;;
  Linux)  HOSTOS=linux ;;
  *) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  arm64|aarch64) HOSTARCH=arm64 ;;
  x86_64|amd64)  HOSTARCH=amd64 ;;
  *) echo "unsupported CPU: $(uname -m)" >&2; exit 1 ;;
esac
# A shell under Rosetta reports x86_64 on Apple Silicon; the real CPU is arm64.
if [ "$HOSTOS" = darwin ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = 1 ]; then
  HOSTARCH=arm64
fi
# --------------------------------------------------------------------------

[ $# -gt 0 ] || set -- darwin/arm64 darwin/amd64 linux/arm64 linux/amd64

for target in "$@"; do
  case "$target" in
    darwin/arm64|darwin/amd64|linux/arm64|linux/amd64) ;;
    *) echo "unsupported target: $target (want darwin|linux / arm64|amd64)" >&2; exit 1 ;;
  esac
  os=${target%/*}
  arch=${target#*/}
  out="bin/$name-$os-$arch"
  # CGO_ENABLED=0: no program here uses cgo, and it makes cross-builds work.
  GOOS=$os GOARCH=$arch CGO_ENABLED=0 go build -trimpath -o "$out" ./cmd/git-sync

  # Prove what was built: go version -m reads the settings embedded in the binary.
  built=$(go version -m "$out" | awk -F'\t' '$2=="build" && $3 ~ /^GO(OS|ARCH)=/ {sub(/^GO(OS|ARCH)=/,"",$3); printf "%s ", $3}')
  [ "$built" = "$arch $os " ] || { echo "built $built, wanted $os/$arch" >&2; exit 1; }
  echo "built $(pwd)/$out for $os/$arch"

  if [ "$os" = "$HOSTOS" ] && [ "$arch" = "$HOSTARCH" ]; then
    ln -sfn "$name-$os-$arch" "bin/$name"    # relative, so the repo can move
  fi
done
